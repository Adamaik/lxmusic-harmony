# ---------------------------------------------------------------- 依赖与本地配置
/node_modules
/oh_modules
# SDK / 设备等本机路径，每台机器不一样
/local.properties
# DevEco Studio 的工程配置（包含 .idea 缓存）
/.idea
# 应用分析器
/.appanalyzer

# ---------------------------------------------------------------- 构建产物
**/build
/.hvigor
/.preview
.cxx
/.clangd
/.clang-format
/.clang-tidy
**/.test
# 安装包 / 共享包
*.hap
*.hsp
*.har

# ---------------------------------------------------------------- 本机调试残留
# 调试截图、UI dump、探针输出等临时文件
/tmp/
# DevEco 的 AI 助手工作目录（自身是个 git 仓库，属于本机工具状态）
/.codegenie/

# ---------------------------------------------------------------- 本机签名配置
# 里面是证书绝对路径与 DevEco 加密后的密码，只对生成它的机器有效；
# 模板见 build-profile.template.json5
/build-profile.json5
