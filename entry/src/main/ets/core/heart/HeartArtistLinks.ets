export function relatedArtists(artist: string): string[] {
  return neighbors.get(artist.trim().toLowerCase()) ?? [];
}

export function artistLinks(seeds: string[]): Map<string, number> {
  const links = new Map<string, number>();
  for (const seed of seeds) {
    const names = relatedArtists(seed);
    const scores = strengths.get(seed.trim().toLowerCase()) ?? [];
    for (let i = 0; i < names.length; i++) {
      links.set(names[i], Math.max(links.get(names[i]) ?? 0, scores[i]));
    }
  }
  return links;
}
